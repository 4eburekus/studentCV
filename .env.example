# Скопируйте в .env и заполните значения. Файл .env не коммитится.
# ВНИМАНИЕ: пересохранять .env через PowerShell Set-Content нельзя -
# получается UTF-16, который Docker не читает, и сервисы стартуют с
# пустыми переменными.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=studentcv
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=studentcv

# Внутри сети compose хост БД - db. Снаружи (с хост-машины) - 127.0.0.1:5433
DATABASE_URL=postgresql+asyncpg://studentcv:change_me_dev_password@db:5432/studentcv

SQL_ECHO=0

# --- pgAdmin 4 (только dev-таргет) --------------------------------------------
# Формат e-mail обычный: pgAdmin отвергает домены вида .local
PGADMIN_DEFAULT_EMAIL=dev@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin

# --- Хранилище объектов: SeaweedFS ---------------------------------------------
# Одна-единственная пара ключей для backend-учётки: её читает и entrypoint
# хранилища (генерирует s3.json), и приложение (app/core/config.py). Второй
# пары быть не должно: расхождение всплывает как AccessDenied в рантайме.
#
# Backend имеет Admin-действия: создаёт бакеты и включает versioning при старте
# (app.services.storage.ensure_buckets).
STORAGE_ADMIN_ACCESS_KEY=studentcv-backend
STORAGE_ADMIN_SECRET_KEY=change_me_storage_secret

# Учётка нативного CV-процесса: запись/чтение кадров в frames, без доступа
# к эталонам и без права создавать бакеты (права заданы в entrypoint storage).
CV_ACCESS_KEY=studentcv-cv
CV_SECRET_KEY=change_me_cv_secret

S3_REGION=us-east-1
S3_BUCKET_BIOMETRICS=biometrics
S3_BUCKET_FRAMES=frames

# Адрес для контейнеров - внутри сети compose (хост storage, порт 8333).
# С хост-машины (нативный CV-процесс) - http://127.0.0.1:8333
S3_ENDPOINT=http://storage:8333

# Эндпоинт для presigned URL. Не задавать, пока топология фронта не решена:
# подпись содержит тот хост, который указан здесь, и браузер должен до него
# достать. Включать вместе с срезом presigned-загрузки.
# S3_ENDPOINT_PUBLIC=http://127.0.0.1:8333

# --- Приложение ----------------------------------------------------------------
API_PORT=8000

# Заглушка авторизации (требование №11 реальным входом НЕ закрыто).
# В dist-таргете AUTH_STUB_ENABLED принудительно false - приложение не стартует.
AUTH_STUB_LOGIN=teacher
AUTH_STUB_ENABLED=true

# --- Бизнес-правила --------------------------------------------------------------
# Требование №8: эталонных фото на студента от 1 до 5. Нижняя граница
# предупреждает, но не блокирует удаление последнего.
MIN_PHOTOS=1
MAX_PHOTOS=5
