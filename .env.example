# Скопируйте в .env и заполните значения. Файл .env не коммитится.
POSTGRES_USER=studentcv
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=studentcv

# Внутри сети compose хост БД - db. Снаружи (с хост-машины) - 127.0.0.1:5433
DATABASE_URL=postgresql+asyncpg://studentcv:change_me_dev_password@db:5432/studentcv

SQL_ECHO=0

PGADMIN_DEFAULT_EMAIL=dev@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin
